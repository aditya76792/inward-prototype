           <div class="col-6 col-md-3">EAN<br><b class="text-dark">${l.ean}</b></div>
           <div class="col-6 col-md-3">Grammage<br><b class="text-dark">${l.desc.match(/\d+ml|\d+g/)?.[0]||"—"}</b></div>
           <div class="col-6 col-md-3">PO / master MRP<br><b class="text-dark">₹${l.masterMRP}</b></div>
