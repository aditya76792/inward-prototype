function run3way(){
  const l=getLine(SESSION.currentLineId);
  const phys=parseFloat($("#physMRP").value);
  if(isNaN(phys)){ toast("Enter the physical MRP","err"); return; }
  l.physicalMRP=phys; l.flags=[]; l.rekeyConfirmed=false;
  if(phys!==l.masterMRP){
    l.flags.push({type:"block",code:"Incorrect SKU",text:`Physical ₹${phys} ≠ PO/master ₹${l.masterMRP} — wrong variant. Blocking; requires re-key confirmation.`});
  } else if(l.invoiceMRP!==l.masterMRP){
    l.flags.push({type:"block",code:"Physical × Invoice variance",text:`Physical = master ₹${l.masterMRP} but Invoice states ₹${l.invoiceMRP}. Blocking; correctable via revised invoice / E42, else RTV.`});
  }
  if(l.invoiceQty>l.poQty){
    l.flags.push({type:"info",code:"PO–Invoice variance",text:`Invoice qty ${l.invoiceQty} > PO qty ${l.poQty}. Documentary, non-blocking auto-flag.`});
  }
  const blocking=l.flags.some(f=>f.type==="block");
  l.qcStatus = blocking?"discrepancy":"in-progress";
  renderThreeWay(l); renderRail();
}
function renderThreeWay(l){
  const blocking=l.flags.filter(f=>f.type==="block");
  const info=l.flags.filter(f=>f.type!=="block");
  let html="";
  if(!l.flags.length){ html=`<div class="flag flag-ok"><i class="bi bi-check-circle"></i>3-way match clean — Physical = Invoice = PO/master.</div>`; }
  blocking.forEach(f=>html+=`<div class="flag flag-block"><i class="bi bi-exclamation-octagon"></i><b class="me-1">${f.code}:</b>${f.text}</div>`);
  info.forEach(f=>html+=`<div class="flag flag-info"><i class="bi bi-info-circle"></i><b class="me-1">${f.code}:</b>${f.text}</div>`);
  if(blocking.length){
    html+=`<div class="mt-2 p-2" style="background:#fff8f8;border:1px solid #f3c8c8;border-radius:10px">
      <div class="form-check"><input class="form-check-input" type="checkbox" id="rekey" ${l.rekeyConfirmed?"checked":""} data-act="rekeyToggle">
        <label class="form-check-label small" for="rekey">I re-checked the product and confirm the keyed MRP (re-key confirmation, FR-2.4).</label></div>
      <div class="mt-2 d-flex gap-2 flex-wrap">
        <button class="btn btn-sm btn-outline-danger" data-act="markCorrection"><i class="bi bi-arrow-repeat me-1"></i>Hold for central correction</button>
        <button class="btn btn-sm btn-outline-danger" data-act="markRTV"><i class="bi bi-box-arrow-up me-1"></i>Mark RTV</button>
      </div></div>`;
  }
  const canProceed = !blocking.length;
  html+=`<div class="mt-3 d-flex align-items-center gap-3 flex-wrap">
     <div class="form-check"><input class="form-check-input" type="checkbox" id="ftouch" ${l.firstTouch?"checked":""} data-act="ftouchToggle" ${canProceed?"":"disabled"}>
       <label class="form-check-label small" for="ftouch">First-touch confirmed (image + description + MRP)</label></div>
     <button class="btn btn-purplle btn-pill" data-act="toSample" ${canProceed?"":"disabled"}>Proceed to Sample QC <i class="bi bi-arrow-right ms-1"></i></button>
   </div>`;
  $("#threeway").innerHTML=html;
}

/* ============================================================
   SCREEN 3 — SAMPLE QC
   ============================================================ */
function ensureSample(l){
  l.sampleSize=sampleSizeFor(l);
  // (re)build sampled boxes only if empty
  if(l.boxes.filter(b=>b.sampled).length!==l.sampleSize){
    l.boxes=l.boxes.filter(b=>!b.sampled); // keep non-sampled (none yet at this stage)
    for(let i=0;i<l.sampleSize;i++){
      l.boxes.unshift({uid:`UID-${l.sku}-S${i+1}`, sampled:true, scanned:false, batchRef:"", mfg:"", exp:"", boxQty:0, short:0, excess:0, damaged:0, rtv:0, labelFlag:"", images:0});
    }
  }
}
function renderSample(){
  const l=getLine(SESSION.currentLineId);
  ensureSample(l);
  const qr = SESSION.vendor.qrEnabled;
  const sampled=l.boxes.filter(b=>b.sampled);
  const defRate = sampled.length? Math.round(100*sampled.filter(boxIsDefective).length/sampled.length):0;

  let batchBlock="";
  if(!qr){
    batchBlock=`<div class="mb-3 p-3" style="background:#faf9fc;border:1px solid #eee;border-radius:12px">
      <div class="sect-title mb-2">Batch declaration (UID-only vendor) — operator declared</div>
      <div class="row g-2 align-items-end">
        <div class="col-md-3"><label class="form-label small">Mfg date</label><input type="date" class="form-control" id="bMfg" value="${addMonths(-2)}"></div>
        <div class="col-md-3"><label class="form-label small">Exp date</label><input type="date" class="form-control" id="bExp" value="${addMonths(16)}"></div>
        <div class="col-md-3"><label class="form-label small">Vendor batch</label><input class="form-control" id="bVend" placeholder="e.g. VB-8841"></div>
        <div class="col-md-3"><button class="btn btn-outline-purplle w-100" style="border-color:var(--purplle);color:var(--purplle)" data-act="addBatch"><i class="bi bi-plus-lg me-1"></i>Add batch</button></div>
      </div>
      <div class="mt-2 d-flex flex-wrap gap-2">${l.batches.map((b,i)=>`<span class="pill st-pending">${b.vend||"batch"} · ${b.exp} <i class="bi bi-x ms-1" data-act="delBatch" data-i="${i}" style="cursor:pointer"></i></span>`).join("")||'<span class="note">No batch declared yet.</span>'}</div>
      <div class="note mt-2">Quantity & discrepancy are captured once at UID level on Screen 4 and shown read-only here (FR-3.3).</div>
    </div>`;
  }

  const boxCards = sampled.map((b,i)=>sampleBoxCard(l,b,i,qr)).join("");
  ws().innerHTML=`
   <div class="card card-soft"><div class="card-body">
     <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
       <div class="sect-title">Screen 3 · Sample QC — ${l.sku}</div>
       <div class="d-flex gap-2 align-items-center">
         <span class="pill st-pending">Sample ${l.sampleSize} of ${l.boxCount} boxes (${CONFIG.samplePct}%, cap ${CONFIG.sampleCap})</span>
         <span class="pill ${defRate>CONFIG.escalationPct?'st-disc':'st-qc'}">Defect ${defRate}%</span>
       </div>
     </div>
     ${l.escalated?`<div class="flag flag-block mt-2"><i class="bi bi-arrow-up-right-circle"></i><b class="me-1">Escalated to 100% inspection (pre-GR).</b>Sample defect ${defRate}% &gt; ${CONFIG.escalationPct}% (FR-3.7). All ${l.boxCount} boxes must be inspected.</div>`:""}
     ${batchBlock}
     <div class="mt-2">${boxCards}</div>
     <div class="mt-3 text-end">
       <button class="btn btn-purplle btn-pill" data-act="toReceiving">Proceed to Receiving <i class="bi bi-arrow-right ms-1"></i></button>
     </div>
     <div class="note mt-2"><i class="bi bi-info-circle me-1"></i>Sampled boxes carry forward to Screen 4 and are never re-scanned (FR-3.8).</div>
   </div></div>`;
}
function sampleBoxCard(l,b,i,qr){
  const sal=saleableOf(b);
  const labelOpts=["","Unreadable QR","MFG-EXP mismatch","Wrong vendor batch"].map(o=>`<option ${b.labelFlag===o?"selected":""}>${o||"— label ok —"}</option>`).join("");
  return `<div class="box-row sampled" data-box="${b.uid}">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div class="fw-semibold"><i class="bi bi-box-seam me-1"></i>${b.uid} <span class="note">sample #${i+1}</span></div>
      ${qr?`<button class="btn btn-sm ${b.scanned?'btn-outline-success':'btn-outline-purplle'}" style="${b.scanned?'':'border-color:var(--purplle);color:var(--purplle)'}" data-act="scanQR" data-uid="${b.uid}">
        <i class="bi bi-qr-code-scan me-1"></i>${b.scanned?'QR read':'Scan QR'}</button>`:''}
    </div>
    ${qr&&b.scanned?`<div class="note mt-1">MFG ${b.mfg} · EXP ${b.exp} · Batch ${b.batchRef} · Box qty ${b.boxQty}</div>`:''}
    ${(qr&&!b.scanned)?'<div class="note mt-1 text-warning">Scan QR to populate batch & box qty.</div>':`
    <div class="row g-2 mt-1 align-items-end">
      ${!qr?`<div class="col-6 col-md-2"><label class="form-label small mb-0">Box qty</label><input type="number" class="form-control form-control-sm mini" data-field="boxQty" data-uid="${b.uid}" value="${b.boxQty}"></div>`:''}
      <div class="col-6 col-md-2"><label class="form-label small mb-0">Short</label><input type="number" class="form-control form-control-sm mini" data-field="short" data-uid="${b.uid}" value="${b.short}"></div>
      <div class="col-6 col-md-2"><label class="form-label small mb-0">Excess</label><input type="number" class="form-control form-control-sm mini" data-field="excess" data-uid="${b.uid}" value="${b.excess}"></div>
      <div class="col-6 col-md-2"><label class="form-label small mb-0">Damaged</label><input type="number" class="form-control form-control-sm mini" data-field="damaged" data-uid="${b.uid}" value="${b.damaged}"></div>
      <div class="col-6 col-md-2"><label class="form-label small mb-0">RTV</label><input type="number" class="form-control form-control-sm mini" data-field="rtv" data-uid="${b.uid}" value="${b.rtv}"></div>
      <div class="col-6 col-md-2"><div class="note">Saleable</div><div class="fw-bold text-success">${sal}</div></div>
    </div>
    ${qr?`<div class="row g-2 mt-1 align-items-center"><div class="col-md-4"><select class="form-select form-select-sm" data-field="labelFlag" data-uid="${b.uid}">${labelOpts}</select></div>
      ${b.damaged>0?`<div class="col-md-8"><span class="note">Damage images:</span> ${[1,2,3].map(n=>`<i class="bi bi-image${n<=b.images?'-fill text-purplle':''}" data-act="addImg" data-uid="${b.uid}" style="cursor:pointer;font-size:1.1rem;margin:0 2px"></i>`).join("")} <span class="note">(max 3)</span></div>`:''}
    </div>`:''}`}
  </div>`;
}
function updateBox(uid,field,val){
  const l=getLine(SESSION.currentLineId); const b=l.boxes.find(x=>x.uid===uid);
  if(!b) return;
  if(field==="labelFlag") b.labelFlag=val; else b[field]=Math.max(0,parseInt(val)||0);
  // recompute escalation from sample
  const sampled=l.boxes.filter(x=>x.sampled);
  const defRate = sampled.length?100*sampled.filter(boxIsDefective).length/sampled.length:0;
  const wasEsc=l.escalated; l.escalated = defRate>CONFIG.escalationPct;
  if(l.escalated&&!wasEsc) toast(`Line escalated to 100% inspection (defect ${Math.round(defRate)}%)`,"err");
  renderSample();
}
function scanQR(uid){
  const l=getLine(SESSION.currentLineId); const b=l.boxes.find(x=>x.uid===uid);
  b.scanned=true; b.batchRef="VB-"+(1000+Math.floor(Math.random()*9000)); b.mfg=addMonths(-2); b.exp=addMonths(16); b.boxQty=l.boxQty;
  renderSample();
}
function addImg(uid){ const l=getLine(SESSION.currentLineId); const b=l.boxes.find(x=>x.uid===uid); if(b.images<3)b.images++; renderSample(); }

/* ============================================================
   SCREEN 4 — RECEIVING (box-level UID)
   ============================================================ */
function renderReceiving(){
  const l=getLine(SESSION.currentLineId);
  const qr = l.path==="green" || (SESSION.vendor.qrEnabled);
  const uidOnly = !SESSION.vendor.qrEnabled;
  const sampled=l.boxes.filter(b=>b.sampled);
  const received=l.boxes.filter(b=>!b.sampled);
  const done=l.boxes.length; const expected=l.boxCount;

  const carried = sampled.length?`<div class="mb-2"><div class="sect-title mb-1">Carried from Sample QC (read-only)</div>
     ${sampled.map(b=>`<div class="box-row sampled d-flex justify-content-between"><span><i class="bi bi-box-seam me-1"></i>${b.uid}</span>
       <span class="note">qty ${b.boxQty} · saleable ${saleableOf(b)}</span></div>`).join("")}</div>`:"";

  const recvRows = received.map(b=>receiveBoxCard(l,b,qr,uidOnly)).join("");
  const batchSel = uidOnly?`<select class="form-select form-select-sm d-inline w-auto" id="recvBatch">${l.batches.length?l.batches.map((x,i)=>`<option value="${i}">${x.vend||'batch'} · ${x.exp}</option>`).join(""):'<option>declare batch on Screen 3</option>'}</select>`:'';

  ws().innerHTML=`
   <div class="card card-soft"><div class="card-body">
     <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
       <div class="sect-title">Screen 4 · Receiving — ${l.sku} ${l.path==="green"?'<span class="pill badge-green ms-1">Green-direct</span>':''}</div>
       <span class="pill st-progress">${done} / ${expected} boxes</span>
     </div>
     ${carried}
     <div class="d-flex align-items-center gap-2 my-2 flex-wrap">
       <button class="btn btn-sm btn-purplle" data-act="scanBox"><i class="bi bi-upc-scan me-1"></i>${qr?'Scan QR + UID':'Scan UID'}</button>
       ${uidOnly?`<span class="note">Batch:</span> ${batchSel}`:''}
       <span class="note">${qr?'Box qty auto-populated from QR.':'UID-only — box qty entered manually, batch pinned.'}</span>
     </div>
     <div>${recvRows||'<div class="note">No boxes received yet — scan to begin.</div>'}</div>
     <div class="mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
       <div class="blocker"><i class="bi bi-flag me-1"></i>Open blocker: multi-GR per line (PRD §17) — line may stay open after first Add-to-Summary. Modelled as provisional.</div>
       <button class="btn btn-purplle btn-pill" data-act="addToSummary" ${done?'':'disabled'}>Add to summary <i class="bi bi-arrow-right ms-1"></i></button>
     </div>
   </div></div>`;
}
function receiveBoxCard(l,b,qr,uidOnly){
  const sal=saleableOf(b);
  return `<div class="box-row">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div class="fw-semibold"><i class="bi bi-box me-1"></i>${b.uid} ${b.batchRef?`<span class="note">· ${b.batchRef}</span>`:''}</div>
      <div class="note">EXP <input type="date" class="form-control form-control-sm d-inline" style="width:150px" data-field="exp" data-uid="${b.uid}" value="${b.exp}"> <span class="ms-1">(edit to test freshness)</span></div>
    </div>
    <div class="row g-2 mt-1 align-items-end">
      <div class="col-6 col-md-2"><label class="form-label small mb-0">Box qty</label><input type="number" class="form-control form-control-sm mini" data-field="boxQty" data-uid="${b.uid}" value="${b.boxQty}" ${qr?'readonly':''}></div>
      <div class="col-6 col-md-2"><label class="form-label small mb-0">Short</label><input type="number" class="form-control form-control-sm mini" data-field="short" data-uid="${b.uid}" value="${b.short}"></div>
      <div class="col-6 col-md-2"><label class="form-label small mb-0">Excess</label><input type="number" class="form-control form-control-sm mini" data-field="excess" data-uid="${b.uid}" value="${b.excess}"></div>
      <div class="col-6 col-md-2"><label class="form-label small mb-0">Damaged</label><input type="number" class="form-control form-control-sm mini" data-field="damaged" data-uid="${b.uid}" value="${b.damaged}"></div>
      <div class="col-6 col-md-2"><label class="form-label small mb-0">RTV</label><input type="number" class="form-control form-control-sm mini" data-field="rtv" data-uid="${b.uid}" value="${b.rtv}"></div>
      <div class="col-6 col-md-2"><div class="note">Saleable</div><div class="fw-bold text-success">${sal}</div></div>
    </div>
  </div>`;
}
function scanBox(){
  const l=getLine(SESSION.currentLineId);
  const qr = l.path==="green" || SESSION.vendor.qrEnabled;
  const received=l.boxes.filter(b=>!b.sampled);
  if(l.boxes.length>=l.boxCount){ toast("All expected boxes already scanned","info"); return; }
  const seq=received.length+1;
  let batchRef="", exp=addMonths(16), mfg=addMonths(-2), boxQty=0;
  if(qr){ batchRef="VB-"+(1000+Math.floor(Math.random()*9000)); boxQty=l.boxQty; }
  else { const bi=$("#recvBatch")?parseInt($("#recvBatch").value):0; const bt=l.batches[bi]; if(bt){batchRef=bt.vend||"batch"; exp=bt.exp; mfg=bt.mfg;} boxQty=l.boxQty; }
  l.boxes.push({uid:`UID-${l.sku}-R${seq}`, sampled:false, scanned:true, batchRef, mfg, exp, boxQty, short:0,excess:0,damaged:0,rtv:0, labelFlag:"", images:0});
  renderReceiving();
}
function updateRecvBox(uid,field,val){
  const l=getLine(SESSION.currentLineId); const b=l.boxes.find(x=>x.uid===uid);
  if(field==="exp") b.exp=val; else b[field]=Math.max(0,parseInt(val)||0);
  renderReceiving();
}
function addToSummary(){
  const l=getLine(SESSION.currentLineId);
  l.addedToSummary=true; l.qcStatus="qc-completed";
  toast(`${l.sku} added to summary`,"ok");
  route("worklist");
}

