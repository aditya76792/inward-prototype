}
function openLine(id){
  const l=getLine(id);
  if(l.candidates && !l.chosen){ return showSkuModal(l); }
  SESSION.currentLineId=id;
  if(l.qcStatus==="pending") l.qcStatus="in-progress";
  route(l.path==="green" ? "receiving" : "identity");
}
function showSkuModal(l){
  $("#skuModalBody").innerHTML = `<p class="note">EAN ${l.ean} maps to multiple SKUs. Select the physical product to proceed (FR-1.4).</p>`+
    l.candidates.map((c,i)=>`<div class="box-row d-flex justify-content-between align-items-center">
      <div><div class="fw-semibold">${c.desc}</div><div class="note">${c.sku} · MRP ₹${c.mrp}</div></div>
      <button class="btn btn-sm btn-purplle" data-act="pickSku" data-id="${l.id}" data-i="${i}">Select</button></div>`).join("");
  new bootstrap.Modal("#skuModal").show();
}
function pickSku(id,i){
  const l=getLine(id); const c=l.candidates[i];
  l.sku=c.sku; l.desc=c.desc; l.masterMRP=c.mrp; l.invoiceMRP=c.mrp; l.chosen=true;
  bootstrap.Modal.getInstance("#skuModal").hide();
  SESSION.currentLineId=id; l.qcStatus="in-progress"; route("identity");
}

/* ============================================================
