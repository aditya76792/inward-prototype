
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Purplle | QC Module — Inbound GR & Quality Control</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<style>
  :root{
    --purplle:#662d91; --purplle-light:#f3e5f5; --purplle-dark:#4a148c;
    --accent:#e91e63; --bg:#f6f5f8; --ink:#2b2540; --muted:#7a7390;
    /* 5-colour QC state code (BRD 5.4) */
    --st-pending:#e9e7ee; --st-progress:#f9c74f; --st-disc:#e24b4a;
    --st-qc:#43a047; --st-grn:#9e9e9e; --st-err:#e24b4a;
  }
  *{scrollbar-width:thin}
  body{background:var(--bg); font-family:'Segoe UI',Tahoma,sans-serif; color:var(--ink); padding-bottom:120px; overflow-y:auto!important;}
  .navbar{background:var(--purplle); border-bottom:3px solid var(--accent);}
  .navbar .brand{font-weight:700; color:#fff; letter-spacing:.2px;}
  .navbar .sub{color:#e6d7f2; font-size:.72rem;}
  .badge-ref{background:#fff; color:var(--purplle); font-weight:600;}

  /* flow rail */
  .rail{display:flex; gap:6px; flex-wrap:wrap; background:#fff; border-radius:12px; padding:10px 12px; box-shadow:0 2px 12px rgba(0,0,0,.05);}
  .rail .step{flex:1 1 0; min-width:120px; display:flex; align-items:center; gap:8px; padding:8px 10px; border-radius:8px; font-size:.78rem; color:var(--muted); background:#faf9fc; border:1px solid #eee;}
  .rail .step .n{width:22px;height:22px;border-radius:50%;background:#e9e7ee;color:#8a8298;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.72rem;flex:0 0 auto;}
  .rail .step.active{background:var(--purplle); color:#fff; border-color:var(--purplle);}
  .rail .step.active .n{background:#fff;color:var(--purplle);}
  .rail .step.done{background:#eaf5ea; color:#2e7d32; border-color:#cfe8cf;}
  .rail .step.done .n{background:#43a047;color:#fff;}
  .rail .step.skip{opacity:.45; text-decoration:line-through;}

  .card-soft{background:#fff; border:none; border-radius:14px; box-shadow:0 3px 18px rgba(0,0,0,.05);}
  .card-soft .card-header{background:transparent; border-bottom:1px solid #f0eef4; font-weight:600;}
  .sect-title{font-size:.7rem; text-transform:uppercase; letter-spacing:.9px; color:var(--muted); font-weight:700;}
  .scan{max-width:420px}
  .scan .input-group-text{background:#fff; color:var(--purplle);}
  table thead th{background:var(--purplle-light); color:var(--purplle-dark); font-size:.68rem; text-transform:uppercase; letter-spacing:.4px; border:none; padding:12px;}
  table td{vertical-align:middle; padding:12px; font-size:.86rem; border-bottom:1px solid #f1eff5;}
  .pill{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:20px;font-size:.72rem;font-weight:600;}
  .st-pending{background:var(--st-pending);color:#5f5a6e}
  .st-progress{background:#fdf1cf;color:#8a6d0b}
  .st-disc{background:#fde3e3;color:#a32d2d}
  .st-qc{background:#e3f3e3;color:#2e7d32}
  .st-grn{background:#eeeeee;color:#616161}
  .st-err{background:#fde3e3;color:#a32d2d}
  .badge-green{background:#e3f3e3;color:#2e7d32;border:1px solid #cfe8cf}
  .badge-phys{background:#fbeee0;color:#8a5a12;border:1px solid #f0dcc2}
  .flag{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border-radius:8px;font-size:.78rem;margin:3px 0;border:1px solid transparent}
  .flag-block{background:#fde3e3;color:#a32d2d;border-color:#f3c1c1}
  .flag-warn{background:#fdf1cf;color:#8a6d0b;border-color:#f0e0a8}
  .flag-info{background:#e7eefb;color:#1e4b8f;border-color:#c9d9f4}
  .flag-ok{background:#e3f3e3;color:#2e7d32;border-color:#cfe8cf}
  .kpi{background:#faf9fc;border:1px solid #eee;border-radius:10px;padding:12px;text-align:center}
  .kpi .v{font-size:1.4rem;font-weight:700;color:var(--purplle-dark)}
  .kpi .l{font-size:.68rem;color:var(--muted);text-transform:uppercase;letter-spacing:.5px}
  .prod-img{width:64px;height:64px;border-radius:10px;background:linear-gradient(135deg,#efeaf5,#e3d7ef);display:flex;align-items:center;justify-content:center;color:#a58fc0;font-size:1.4rem;flex:0 0 auto}
  .box-row{background:#faf9fc;border:1px solid #eee;border-radius:10px;padding:10px 12px;margin-bottom:8px}
  .box-row.sampled{background:#f2ecfa;border-color:#e0d2f2}
  .box-row.fail{background:#fdf0f0;border-color:#f3c8c8}
  .mini{width:78px}
  .fixed-footer{position:fixed;bottom:22px;left:0;right:0;display:flex;justify-content:center;z-index:1000;pointer-events:none}
  .fixed-footer .inner{pointer-events:auto;background:#fff;border-radius:50px;box-shadow:0 10px 30px rgba(102,45,145,.18);padding:8px 8px 8px 22px;display:flex;align-items:center;gap:14px;border:1px solid #efe9f5}
  .btn-purplle{background:var(--purplle);color:#fff;border:none}
  .btn-purplle:hover{background:var(--purplle-dark);color:#fff}
  .btn-pill{border-radius:50px;padding:11px 30px;font-weight:600}
  .disp-tile{border-radius:10px;padding:12px;color:#fff;text-align:center}
  .d-tgdc{background:#2e7d32}.d-iwdc{background:#1565c0}.d-dmdc{background:#ef6c00}.d-rvdc{background:#c62828}
  .note{font-size:.76rem;color:var(--muted)}
  .blocker{font-size:.72rem;background:#fff8e1;border:1px dashed #e0b000;color:#7a5c00;border-radius:8px;padding:8px 10px}
  .link-more{cursor:pointer;color:var(--purplle);font-weight:600;font-size:.8rem}
  .hide{display:none!important}
  @media (max-width:640px){ .rail .step{min-width:47%} }
</style>
</head>
<body>

<nav class="navbar px-3 px-md-4 py-2 shadow-sm">
  <div class="container-fluid d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-clipboard-check text-white fs-4"></i>
      <div>
        <div class="brand">QC Module <span class="sub d-none d-md-inline">· Inbound GR & Quality Control · Manage</span></div>
        <div class="sub d-md-none">Inbound GR & QC · Manage</div>
      </div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <span class="badge badge-ref p-2" id="refBadge">No consignment</span>
      <button class="btn btn-sm btn-light" data-bs-toggle="offcanvas" data-bs-target="#cfg" title="Config surface"><i class="bi bi-sliders"></i></button>
    </div>
  </div>
</nav>

<div class="container-fluid px-3 px-md-4 mt-3" style="max-width:1180px">
  <div class="rail mb-3" id="rail"></div>
  <div id="workspace"></div>
</div>

<div class="fixed-footer"><div class="inner" id="footer"></div></div>

<!-- Config surface -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="cfg">
  <div class="offcanvas-header"><h6 class="mb-0"><i class="bi bi-sliders me-2"></i>Configuration surface</h6><button class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body">
    <p class="note">Governed knobs the module runs on (PRD §12). Changes recompute derived values live; eligibility re-evaluates for lines not yet started.</p>
    <label class="form-label small fw-semibold">Sample percentage (%)</label>
    <input type="number" class="form-control mb-3" id="c_samplePct" value="10" min="1" max="100">
    <label class="form-label small fw-semibold">Sample cap (max boxes)</label>
    <input type="number" class="form-control mb-3" id="c_sampleCap" value="5" min="1">
    <label class="form-label small fw-semibold">Escalation threshold (% defect → 100%)</label>
    <input type="number" class="form-control mb-3" id="c_escalationPct" value="20" min="1" max="100">
    <label class="form-label small fw-semibold">Freshness criteria (min days to expiry)</label>
    <input type="number" class="form-control mb-3" id="c_freshnessDays" value="90" min="1">
    <label class="form-label small fw-semibold">Green-Channel eligibility threshold (vendor score)</label>
    <input type="number" class="form-control mb-3" id="c_eligibility" value="80" min="0" max="100">
    <button class="btn btn-purplle w-100" id="c_apply"><i class="bi bi-check2 me-1"></i>Apply configuration</button>
    <hr>
    <p class="note mb-0">Defaults per BRD: 10% sample, 20% escalation, freshness default-pass when SKU master is empty (reuses Freshness Check build).</p>
  </div>
</div>

<!-- Multi-SKU shortlist modal -->
<div class="modal fade" id="skuModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content card-soft">
  <div class="modal-header"><h6 class="modal-title">Select SKU — EAN maps to multiple SKUs</h6><button class="btn-close" data-bs-dismiss="modal"></button></div>
  <div class="modal-body" id="skuModalBody"></div>
</div></div></div>

<!-- Toasts -->
<div class="toast-container position-fixed top-0 end-0 p-3" id="toasts" style="z-index:1200"></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
/* ============================================================
   QC MODULE PROTOTYPE — logic model (PRD v0.1 / BRD v1.0)
   Single-file, in-memory. Panels: Intake → Worklist → Identity
   → Sample → Receiving → Summary/GR (+ post-GR: inward, freshness).
   ============================================================ */

const CONFIG = { samplePct:10, sampleCap:5, escalationPct:20, freshnessDays:90, eligibility:80 };
const today = new Date();
const addMonths = (m)=>{ const d=new Date(today); d.setMonth(d.getMonth()+m); return d.toISOString().slice(0,10); };
const daysBetween = (iso)=> Math.round((new Date(iso)-today)/86400000);

/* ---------- seed consignments (three vendor scenarios) ---------- */
function seedScenarios(){
  return {
    A:{ po:"4500098231", invoice:"INV-A-88123", vendor:{name:"Marico Ltd", configured:true, qrEnabled:true},
        label:"QR-enabled vendor · mixed routing",
        lines:[
          line("MRC-PCO-200","8901234000011","Parachute Coconut Oil 200ml","💧",99,99,240,240,24,10,92),
          line("MRC-LVN-100","8901234000028","Livon Silk Serum 100ml","✨",245,245,120,120,20,6,71),
          line("MRC-SWG-250","8901234000035","Set Wet Hair Gel 250ml","🧴",180,175,110,120,24,5,64), // invoice MRP≠master, invoice qty>po
          line("MRC-NIH-XXX","8901234500019","Nihar Naturals (multi-SKU EAN)","🥥",95,95,80,80,16,5,68,
               [ {sku:"NIH-100",desc:"Nihar Naturals 100ml",mrp:55},
                 {sku:"NIH-200",desc:"Nihar Naturals 200ml",mrp:95} ])
        ]},
    B:{ po:"4500077310", invoice:"INV-B-4471", vendor:{name:"Local Traders (non-QR)", configured:true, qrEnabled:false},
        label:"QR-disabled vendor · UID-only, batch-centric",
        lines:[
          line("LT-FW-150","7001110000015","Herbal Face Wash 150ml","🧼",120,120,100,100,25,4,58),
          line("LT-SH-500","7001110000022","Herbal Shampoo 500ml","🧴",210,210,100,100,20,5,61)
        ]},
    C:{ po:"4500000000", invoice:"INV-C-0001", vendor:{name:"Unregistered Vendor", configured:false, qrEnabled:false},
        label:"Vendor config missing · Screen-0 hard block", lines:[] }
  };
}
let SCN;

function line(sku,ean,desc,img,masterMRP,invoiceMRP,poQty,invoiceQty,boxCount,boxQty,score,candidates){
  return { id:sku, sku, ean, desc, img, masterMRP, invoiceMRP, poQty, invoiceQty, boxCount, boxQty, score,
    candidates:candidates||null, chosen:!candidates,
    eligible:false, path:null, qcStatus:"pending", inwardStatus:"", flags:[], physicalMRP:"", firstTouch:false, rekeyConfirmed:false,
    batches:[], boxes:[], sampleSize:0, escalated:false, addedToSummary:false, selectedForGR:true, forceError:false,
    gr:null };
}

let SESSION = null; // {scenarioKey, po, invoice, vendor, screen, currentLineId}

/* ---------- helpers ---------- */
const $ = (s,r=document)=>r.querySelector(s);
const ws = ()=>$("#workspace");
function toast(msg,kind="info"){
  const icon = kind==="ok"?"check-circle-fill":kind==="err"?"exclamation-triangle-fill":"info-circle-fill";
  const col = kind==="ok"?"#2e7d32":kind==="err"?"#c62828":"#662d91";
  const t=document.createElement("div");
  t.className="toast align-items-center show border-0 mb-2"; t.style.background="#fff";
  t.innerHTML=`<div class="d-flex"><div class="toast-body d-flex align-items-center gap-2" style="color:${col}"><i class="bi bi-${icon}"></i><span>${msg}</span></div><button class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button></div>`;
  $("#toasts").appendChild(t); setTimeout(()=>t.remove(),3200);
}
const STATUS = {pending:["Pending","st-pending"],"in-progress":["In progress","st-progress"],discrepancy:["Discrepancy","st-disc"],"qc-completed":["QC completed","st-qc"],"grn-completed":["GRN completed","st-grn"]};
const statusPill = s => `<span class="pill ${STATUS[s][1]}">${STATUS[s][0]}</span>`;
const inwardPill = s => s==="inwarded"?`<span class="pill st-qc">Inwarded</span>`: s==="sap-error"?`<span class="pill st-err">SAP error</span>`: s==="gon-out"?`<span class="pill st-err">GON-out (RTV)</span>`: s==="rack-in"?`<span class="pill st-qc">Rack-in eligible</span>`:`<span class="text-muted small">—</span>`;

function linePath(l,vendor){
  if(!vendor.configured) return "block";
  if(l.eligible) return "green";
  return vendor.qrEnabled ? "physical-qr" : "physical-uid";
}
function evalEligibility(){
  if(!SESSION) return;
  SESSION.vendor && SCN[SESSION.scenarioKey].lines.forEach(l=>{
    if(l.qcStatus==="pending" && !l.addedToSummary){
      l.eligible = SESSION.vendor.qrEnabled && l.score>=CONFIG.eligibility;
      l.path = linePath(l, SESSION.vendor);
    }
  });
}
const activeLines = ()=> SESSION ? SCN[SESSION.scenarioKey].lines : [];
const getLine = id => activeLines().find(l=>l.id===id);
const sampleSizeFor = l => Math.min(CONFIG.sampleCap, Math.max(1, Math.ceil(l.boxCount*CONFIG.samplePct/100)));
const saleableOf = b => Math.max(0, (b.boxQty||0)-(b.short||0)+(b.excess||0)-(b.damaged||0)-(b.rtv||0));
const boxIsDefective = b => (b.short>0||b.excess>0||b.damaged>0||b.rtv>0||b.labelFlag);
function lineTotals(l){
  let t={boxQty:0,saleable:0,short:0,excess:0,damaged:0,rtv:0,boxes:l.boxes.length};
  l.boxes.forEach(b=>{ t.boxQty+=b.boxQty||0; t.saleable+=saleableOf(b); t.short+=b.short||0; t.excess+=b.excess||0; t.damaged+=b.damaged||0; t.rtv+=b.rtv||0; });
  return t;
}

/* ============================================================
   ROUTER
   ============================================================ */
function route(screen){ if(screen) SESSION.screen=screen; renderRail(); renderScreen(); renderFooter(); window.scrollTo({top:0,behavior:"smooth"}); }

function renderRail(){
  const steps=[["intake","Intake"],["worklist","Worklist"],["identity","Identity"],["sample","Sample QC"],["receiving","Receiving"],["summary","Summary & GR"]];
  const order=steps.map(s=>s[0]); const cur=SESSION?SESSION.screen:"intake";
  const l = SESSION && SESSION.currentLineId ? getLine(SESSION.currentLineId):null;
  const skipQC = l && l.path==="green";
  $("#rail").innerHTML = steps.map((s,i)=>{
    let cls="step"; const idx=order.indexOf(s[0]); const curIdx=order.indexOf(cur);
    if(s[0]===cur) cls+=" active"; else if(idx<curIdx) cls+=" done";
    if(skipQC && (s[0]==="identity"||s[0]==="sample")) cls+=" skip";
    const num = i===0?"0":i;
    return `<div class="${cls}"><span class="n">${num}</span><span>${s[1]}</span></div>`;
  }).join("");
}

function renderFooter(){
  const f=$("#footer"); f.innerHTML=""; if(!SESSION) return;
  const s=SESSION.screen;
  const wrap=(label,html)=>`<span class="note d-none d-md-inline">${label}</span>${html}`;
  if(s==="worklist"){
    const anyAdded=activeLines().some(l=>l.addedToSummary);
    f.innerHTML=wrap("Worklist",`<button class="btn btn-purplle btn-pill" data-act="goSummary" ${anyAdded?"":"disabled"}>Review summary <i class="bi bi-arrow-right ms-1"></i></button>`);
  } else if(s==="summary"){
    const sel=activeLines().filter(l=>l.addedToSummary&&l.selectedForGR&&!(l.gr&&l.gr.posted));
    f.innerHTML=`<button class="btn btn-outline-secondary btn-pill" data-act="backWork"><i class="bi bi-arrow-left me-1"></i>Worklist</button>
      <button class="btn btn-purplle btn-pill" data-act="submitGR" ${sel.length?"":"disabled"}>Submit ${sel.length} line(s) → SAP GR</button>`;
  } else if(["identity","sample","receiving"].includes(s)){
    f.innerHTML=`<button class="btn btn-outline-secondary btn-pill" data-act="backWork"><i class="bi bi-arrow-left me-1"></i>Back to worklist</button>`;
  } else if(s==="intake"){
    f.innerHTML=`<span class="note">Enter a consignment to begin</span>`;
  }
}

/* ============================================================
   SCREEN 0 — INTAKE
   ============================================================ */
function renderIntake(){
  const opts=Object.entries(SCN).map(([k,v])=>`<option value="${k}">${k} — ${v.label}</option>`).join("");
  ws().innerHTML=`
   <div class="card card-soft mb-3"><div class="card-body">
     <div class="sect-title mb-2">Screen 0 · Inbound intake</div>
     <div class="row g-3 align-items-end">
       <div class="col-md-3">
         <label class="form-label small fw-semibold">Demo consignment</label>
         <select class="form-select" id="scn">${opts}</select>
       </div>
       <div class="col-md-3">
         <label class="form-label small fw-semibold">SAP PO number</label>
         <div class="input-group scan"><span class="input-group-text"><i class="bi bi-hash"></i></span><input class="form-control" id="poIn"></div>
       </div>
       <div class="col-md-3">
         <label class="form-label small fw-semibold">Invoice number</label>
         <div class="input-group scan"><span class="input-group-text"><i class="bi bi-receipt"></i></span><input class="form-control" id="invIn"></div>
       </div>
       <div class="col-md-3">
         <button class="btn btn-purplle w-100" id="validateBtn"><i class="bi bi-shield-check me-1"></i>Run validation</button>
       </div>
     </div>
     <div id="intakeResult" class="mt-3"></div>
   </div></div>`;
  const fill=()=>{ const v=SCN[$("#scn").value]; $("#poIn").value=v.po; $("#invIn").value=v.invoice; $("#intakeResult").innerHTML=""; };
  $("#scn").onchange=fill; fill();
  $("#validateBtn").onclick=runIntakeValidation;
}
function chip(ok,label){ return `<div class="flag ${ok?"flag-ok":"flag-block"} me-2"><i class="bi bi-${ok?"check-circle":"x-circle"}"></i>${label}</div>`; }
function runIntakeValidation(){
  const key=$("#scn").value; const v=SCN[key];
  SESSION={ scenarioKey:key, po:$("#poIn").value, invoice:$("#invIn").value, vendor:v.vendor, screen:"intake", currentLineId:null };
  $("#refBadge").textContent=`PO ${SESSION.po} · ${v.vendor.name}`;
  evalEligibility();
  const gate1 = v.vendor.configured;
  const sanity = `<div class="d-flex flex-wrap mb-2">${chip(true,"Invoice = Gate-IN")}${chip(true,"Vendor found")}${chip(true,"BU found")}${chip(true,"GSTN match")}${chip(true,"PO ↔ location")}</div>`;
  const gate = `<div class="d-flex flex-wrap">${chip(gate1,"Vendor QR / Green-Channel config")}</div>`;
  if(!gate1){
    $("#intakeResult").innerHTML = sanity+gate+
      `<div class="flag flag-block mt-2"><i class="bi bi-slash-circle"></i><b class="ms-1">Hard block at intake (FR-0.4).</b>&nbsp;Vendor config not maintained — cannot receive. Advise config setup, then retry.</div>`;
    renderFooter(); return;
  }
  const lines=v.lines;
  const invQty=lines.reduce((a,l)=>a+l.invoiceQty,0);
  const boxes=lines.reduce((a,l)=>a+l.boxCount,0);
  const gcCount=lines.filter(l=>l.eligible).length;
  const qcCount=lines.length-gcCount;
  $("#intakeResult").innerHTML = sanity+gate+
    `<div class="row g-2 mt-1">
      <div class="col-6 col-md-3"><div class="kpi"><div class="v">${invQty}</div><div class="l">Invoice qty</div></div></div>
      <div class="col-6 col-md-3"><div class="kpi"><div class="v">${boxes}</div><div class="l">Box count</div></div></div>
      <div class="col-6 col-md-3"><div class="kpi"><div class="v">${gcCount}</div><div class="l">Green-Channel SKUs</div></div></div>
      <div class="col-6 col-md-3"><div class="kpi"><div class="v">${qcCount}</div><div class="l">QC-required SKUs</div></div></div>
    </div>
    <div class="text-end mt-3"><button class="btn btn-purplle btn-pill" data-act="initiateQC"><i class="bi bi-play-fill me-1"></i>Initiate QC</button></div>`;
  renderFooter();
}

/* ============================================================
   SCREEN 1 — WORKLIST
   ============================================================ */
function renderWorklist(){
  evalEligibility();
  const rows = ()=> {
    const rank={"pending":0,"in-progress":1,"discrepancy":1,"qc-completed":2,"grn-completed":3};
    const q=($("#wlSearch")&&$("#wlSearch").value||"").toLowerCase();
    return activeLines()
      .filter(l=>!q||l.desc.toLowerCase().includes(q)||l.ean.includes(q)||l.sku.toLowerCase().includes(q))
      .sort((a,b)=>rank[a.qcStatus]-rank[b.qcStatus])
      .map(l=>{
        const elig = l.eligible?`<span class="pill badge-green"><i class="bi bi-lightning-charge"></i>Green-direct</span>`
                               :`<span class="pill badge-phys"><i class="bi bi-search"></i>Physical QC</span>`;
        const route = l.eligible?"→ Receiving": l.path==="physical-uid"?"→ Identity (UID-only)":"→ Identity";
        const disabled = l.qcStatus==="grn-completed";
        return `<tr>
          <td><div class="d-flex align-items-center gap-2"><div class="prod-img" style="width:40px;height:40px;font-size:1rem">${l.img}</div>
            <div><div class="fw-semibold" style="font-size:.86rem">${l.desc}</div><div class="note">${l.sku} · EAN ${l.ean}${l.candidates&&!l.chosen?' · <span class="text-warning fw-semibold">multi-SKU</span>':''}</div></div></div></td>
          <td>${elig}<div class="note mt-1">score ${l.score}</div></td>
