   ============================================================ */
function renderIdentity(){
  const l=getLine(SESSION.currentLineId);
  ws().innerHTML=`
   <div class="card card-soft"><div class="card-body">
     <div class="sect-title mb-2">Screen 2 · Identity verification — ${l.sku}</div>
