function renderSummary(){
  const lines=activeLines().filter(l=>l.addedToSummary);
  const rows=lines.map(l=>{
    const t=lineTotals(l); const tickets=l.flags.filter(f=>f.type!=="info").length + l.boxes.filter(b=>b.labelFlag).length;
    const posted=l.gr&&l.gr.posted;
    return `<tr>
      <td><input type="checkbox" class="form-check-input" data-act="selLine" data-id="${l.id}" ${l.selectedForGR?"checked":""} ${posted?"disabled":""}></td>
      <td><div class="fw-semibold" style="font-size:.85rem">${l.sku}</div><div class="note">${l.desc}</div>
          ${l.path==="green"?'<span class="pill badge-green mt-1">Green-direct</span>':''}${l.escalated?'<span class="pill st-disc mt-1">escalated</span>':''}</td>
      <td>${l.invoiceQty}</td>
      <td>${t.saleable+t.damaged+t.rtv}<div class="note">S ${t.short} · E ${t.excess} · Dmg ${t.damaged} · RTV ${t.rtv}</div></td>
      <td>${tickets?`<span class="pill st-disc">${tickets}</span>`:'<span class="note">0</span>'}</td>
      <td>${posted?inwardPill(l.inwardStatus):'<span class="note">ready</span>'}</td>
      <td class="text-end">
        <label class="note d-block"><input type="checkbox" data-act="forceErr" data-id="${l.id}" ${l.forceError?"checked":""} ${posted?"disabled":""}> force SAP error</label>
        <span class="link-more" data-act="drill" data-id="${l.id}"><i class="bi bi-eye"></i> boxes</span>
      </td></tr>
      <tr class="hide" id="drill-${l.id}"><td colspan="7">${boxDetail(l)}</td></tr>`;
  }).join("");
  ws().innerHTML=`
   <div class="card card-soft"><div class="card-body">
     <div class="sect-title mb-2">Summary & GR — select lines to post (partial MIGO)</div>
     <div class="table-responsive"><table class="table mb-0"><thead><tr>
       <th style="width:34px"></th><th>Line</th><th>Invoiced</th><th>Received (GR)</th><th>Tickets</th><th>Inward status</th><th class="text-end">Detail</th>
     </tr></thead><tbody>${rows||'<tr><td colspan="7" class="note">No lines added yet.</td></tr>'}</tbody></table></div>
     <div id="grResult" class="mt-3"></div>
     <div class="note mt-2"><i class="bi bi-info-circle me-1"></i>GR qty = Saleable + Damaged + RTV, split by disposition SLOC. Short/Excess netted, excluded from MIGO. Net excess capped at invoiced (received-not-billed).</div>
   </div></div>`;
  const errCards=lines.filter(l=>l.inwardStatus==="sap-error"&&!(l.gr&&l.gr.posted)).map(errCard).join("");
  const doneCards=lines.filter(l=>l.gr&&l.gr.posted).map(grResultCard).join("");
  $("#grResult").innerHTML=errCards+doneCards;
}
function errCard(l){
  return `<div class="flag flag-block"><i class="bi bi-plug"></i><b class="me-1">SAP error — ${l.sku}:</b> MIGO rejected (SKU–SLOC–Plant extension). Box-code error file generated.
    <button class="btn btn-sm btn-danger ms-2" data-act="repush" data-id="${l.id}"><i class="bi bi-arrow-clockwise me-1"></i>Apply &amp; Repush</button></div>`;
}
function boxDetail(l){
  return `<div class="p-2">${l.boxes.map(b=>`<div class="box-row ${b.sampled?'sampled':''} d-flex justify-content-between flex-wrap">
    <span><i class="bi bi-box-seam me-1"></i>${b.uid} ${b.sampled?'<span class="note">(sampled)</span>':''}</span>
    <span class="note">qty ${b.boxQty} · sal ${saleableOf(b)} · dmg ${b.damaged} · rtv ${b.rtv} · exp ${b.exp||'—'}${b.labelFlag?' · '+b.labelFlag:''}</span>
  </div>`).join("")}</div>`;
}
function submitGR(){
  const sel=activeLines().filter(l=>l.addedToSummary&&l.selectedForGR&&!(l.gr&&l.gr.posted));
  sel.forEach(l=>{
    if(l.forceError){ l.gr={posted:false}; l.inwardStatus="sap-error"; return; }
    postLineGR(l);
  });
  const errs=sel.filter(l=>l.forceError).length;
  toast(`Posted ${sel.length-errs} line(s); ${errs} error(s)`, errs?"err":"ok");
  renderSummary(); renderRail(); renderFooter();
}
function postLineGR(l){
  const t=lineTotals(l);
  // freshness per saleable box (reuse Freshness Check build): fail if days-to-exp < threshold
  let freshFailQty=0, freshFailBoxes=[];
  l.boxes.forEach(b=>{ const sal=saleableOf(b); if(sal>0 && b.exp){ const d=daysBetween(b.exp); if(d<CONFIG.freshnessDays){ freshFailQty+=sal; freshFailBoxes.push(b.uid);} } });
  let saleable=t.saleable - freshFailQty;
  // net excess cap
  const receivedUnits=t.saleable+t.damaged+t.rtv;
  let rnbFlag = (t.saleable>l.invoiceQty);
  const disp={ TGDC:saleable, IWDC:0, DMDC:t.damaged, RVDC:t.rtv+freshFailQty };
  const matdoc="49"+Math.floor(1000000+Math.random()*8999999);
  l.gr={ posted:true, matdoc, disp, short:t.short, excess:t.excess, rnbFlag, freshFailQty, freshFailBoxes,
         audit: l.path==="green" };
  l.qcStatus="grn-completed";
  l.inwardStatus = (saleable>0)?"rack-in":(freshFailQty>0?"gon-out":"inwarded");
}
function grResultCard(l){
  const g=l.gr;
  const tiles=[["TGDC",g.disp.TGDC,"d-tgdc","Saleable"],["IWDC",g.disp.IWDC,"d-iwdc","Cross-dock"],["DMDC",g.disp.DMDC,"d-dmdc","Damaged"],["RVDC",g.disp.RVDC,"d-rvdc","RTV"]]
    .map(([s,q,c,lbl])=>`<div class="col-6 col-md-3"><div class="disp-tile ${c}"><div style="font-size:1.3rem;font-weight:700">${q}</div><div style="font-size:.7rem;opacity:.9">${s} · ${lbl}</div></div></div>`).join("");
  return `<div class="p-3 mb-2" style="background:#faf9fc;border:1px solid #eee;border-radius:12px">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <div><b>${l.sku}</b> · GR posted <span class="note">Matdoc ${g.matdoc}</span></div>
      <div>${inwardPill(l.inwardStatus)} ${g.audit?'<span class="pill badge-phys ms-1"><i class="bi bi-clipboard-check"></i> 100% audit ≤48h</span>':''}</div>
    </div>
    <div class="row g-2">${tiles}</div>
    <div class="mt-2 d-flex flex-wrap gap-2">
      ${g.short?`<span class="flag flag-warn">Short ${g.short} — netted, excluded from MIGO</span>`:''}
      ${g.excess?`<span class="flag flag-warn">Excess ${g.excess} — netted${g.rnbFlag?', received-not-billed':''}</span>`:''}
      ${g.freshFailQty?`<span class="flag flag-block"><i class="bi bi-calendar-x"></i> Freshness fail ${g.freshFailQty} → GON-out RTV (dummy inward-outward, gon_type ‘Return to Vendor’)</span>`:''}
      ${l.inwardStatus==="rack-in"?'<span class="flag flag-ok"><i class="bi bi-check2-circle"></i> Boxes rack-in eligible</span>':''}
    </div>
    <div class="note mt-2">Auto-inward to IOL from Matdoc → freshness (NE) gate applied → disposition as above.</div>
  </div>`;
}

/* ============================================================
   SCREEN dispatcher + event delegation
   ============================================================ */
function renderScreen(){
  const s=SESSION?SESSION.screen:"intake";
  if(s==="intake") return renderIntake();
  if(s==="worklist") return renderWorklist();
  if(s==="identity") return renderIdentity();
  if(s==="sample") return renderSample();
  if(s==="receiving") return renderReceiving();
  if(s==="summary") return renderSummary();
}

document.addEventListener("click",(e)=>{
  const b=e.target.closest("[data-act]"); if(!b) return;
  const act=b.dataset.act, id=b.dataset.id, uid=b.dataset.uid, i=b.dataset.i;
  const l=SESSION&&SESSION.currentLineId?getLine(SESSION.currentLineId):null;
  switch(act){
    case "initiateQC": route("worklist"); break;
    case "openLine": openLine(id); break;
    case "pickSku": pickSku(id,parseInt(i)); break;
    case "run3way": run3way(); break;
    case "rekeyToggle": l.rekeyConfirmed=$("#rekey").checked; break;
    case "ftouchToggle": l.firstTouch=$("#ftouch").checked; break;
    case "markCorrection": l.qcStatus="discrepancy"; toast(`${l.sku} held for central correction`,"info"); route("worklist"); break;
    case "markRTV": l.qcStatus="discrepancy"; l.inwardStatus=""; toast(`${l.sku} marked RTV`,"info"); route("worklist"); break;
    case "toSample":
      if(l.flags.some(f=>f.type==="block")){ toast("Clear the blocking flag first","err"); break; }
      if(!$("#ftouch").checked){ toast("Confirm first-touch to proceed","err"); break; }
      l.firstTouch=true; route("sample"); break;
    case "scanQR": scanQR(uid); break;
    case "addImg": addImg(uid); break;
    case "addBatch": { const v={mfg:$("#bMfg").value,exp:$("#bExp").value,vend:$("#bVend").value}; if(!v.vend){toast("Enter vendor batch","err");break;} l.batches.push(v); renderSample(); } break;
    case "delBatch": l.batches.splice(parseInt(i),1); renderSample(); break;
    case "toReceiving": route("receiving"); break;
    case "scanBox": scanBox(); break;
    case "addToSummary": addToSummary(); break;
    case "goSummary": case "backWork": route(act==="goSummary"?"summary":"worklist"); break;
    case "drill": { const d=$("#drill-"+id); d.classList.toggle("hide"); } break;
    case "selLine": getLine(id).selectedForGR=b.checked; renderFooter(); break;
    case "forceErr": getLine(id).forceError=b.checked; break;
    case "submitGR": submitGR(); break;
    case "repush": { const ln=getLine(id); ln.forceError=false; postLineGR(ln); toast(`${ln.sku} repushed — GR posted`,"ok"); renderSummary(); renderRail(); renderFooter(); } break;
  }
});
document.addEventListener("input",(e)=>{
  const el=e.target; if(!el.dataset.field) return;
  const uid=el.dataset.uid, field=el.dataset.field, val=el.value;
  if(SESSION.screen==="sample") updateBox(uid,field,val);
  else if(SESSION.screen==="receiving") updateRecvBox(uid,field,val);
});

/* config apply */
$("#c_apply").onclick=()=>{
  CONFIG.samplePct=+$("#c_samplePct").value||10;
  CONFIG.sampleCap=+$("#c_sampleCap").value||5;
  CONFIG.escalationPct=+$("#c_escalationPct").value||20;
  CONFIG.freshnessDays=+$("#c_freshnessDays").value||90;
  CONFIG.eligibility=+$("#c_eligibility").value||80;
  evalEligibility();
  toast("Configuration applied","ok");
  bootstrap.Offcanvas.getInstance("#cfg")?.hide();
  route();
};

/* boot */
SCN=seedScenarios();
SESSION={ scenarioKey:"A", po:"", invoice:"", vendor:null, screen:"intake", currentLineId:null };
route("intake");
</script>
</body>
