       <div class="col-md-5"><div class="note">Physical vs PO/master vs Invoice. MRP is identity-defining (0% tolerance).</div></div>
     </div>
     <div id="threeway" class="mt-3"></div>
   </div></div>`;
  if(l.flags.length) renderThreeWay(l);
